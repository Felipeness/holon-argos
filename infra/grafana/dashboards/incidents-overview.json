                  { "options": { "P1": { "color": "red", "text": "P1" } }, "type": "value" },
                  { "options": { "P2": { "color": "orange", "text": "P2" } }, "type": "value" },
                  { "options": { "P3": { "color": "yellow", "text": "P3" } }, "type": "value" },
                  { "options": { "P4": { "color": "blue", "text": "P4" } }, "type": "value" },
                  { "options": { "P5": { "color": "green", "text": "P5" } }, "type": "value" }
